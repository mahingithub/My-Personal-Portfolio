# ============================================
# 🔧 PORTFOLIO BACKEND - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values
# Command: cp .env.example .env

# ---------- Server ----------
PORT=5000
NODE_ENV=development

# ---------- MongoDB ----------
# Get your connection string from https://cloud.mongodb.com
# 1. Create a free cluster
# 2. Go to Database > Connect > Connect your application
# 3. Copy the connection string and replace <password> with your password
MONGODB_URI=mongodb+srv://mahinDbUser:Mahin2024db@cluster0.qy0eeyf.mongodb.net/?appName=Cluster0

# ---------- Email (Nodemailer) ----------
# For Gmail: 
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Generate an App Password (you need 2FA enabled)
# 3. Use that 16-character password below
EMAIL_HOST=asraf2305101543@diu.edu.bd
EMAIL_PORT=587
EMAIL_USER=emrixspa@gmail.com
EMAIL_PASS=bobwoQ-4naffo-hifhir
EMAIL_TO=asraf2305101543@diu.edu.bd

# ---------- Google Sheets (Optional) ----------
# 1. Go to https://console.cloud.google.com
# 2. Create a project > Enable Google Sheets API
# 3. Create a Service Account > Download JSON key
# 4. Copy values from the JSON key file below
# 5. Share your Google Sheet with the service account email
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEET_ID=your-google-sheet-id-here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ---------- Admin ----------
# Set a strong password for the admin dashboard
ADMIN_PASSWORD=changeme123

# ---------- Frontend ----------
# The URL where your frontend is hosted (for CORS)
FRONTEND_URL=https://my-personal-portfolio-alpha-sage.vercel.app/
